//-----------------------------------------------------------------------------
//	HEIGHT2NORMAL.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro OUTBINDIR	"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_exe_con_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE,..\common"
	}
}

$Project "Height2Normal"
{
	$Folder	"Source Files"
	{
		// SP/MP branch separation (see sdk_sp_branch.vpc.vpc)
		-$File	"$SRCDIR\public_sp\tier0\memoverride.cpp" [$WIN32||$LINUX32]
		-$File	"$SRCDIR\public\tier0\memoverride.cpp" [$WIN64||$LINUX64]
		$File	"height2normal.cpp"
	}

	$Folder	"Header Files"
	{
		$File	"$SRCDIR\public\tier1\interface.h"
		$File	"$SRCDIR\public\tier1\utlbuffer.h"
	}

	$Folder	"Link Libraries"
	{
		$Lib bitmap
		$Lib mathlib
		$Lib tier2
	}
}
