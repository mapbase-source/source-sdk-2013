//-----------------------------------------------------------------------------
//	tier0_exclude.vpc
//
//	Project Script
//-----------------------------------------------------------------------------

$Project
{
	$Folder	"Link Libraries"
	{
		// Should match the sites that include this
		-$Lib "$LIBPUBLIC\tier0"	[$POSIX && !$IS_LIB_PROJECT]
	}
	$Folder	"Source Files"
	{
		// SP/MP branch separation (see sdk_sp_branch.vpc.vpc)
		-$File	"$SRCDIR\public_sp\tier0\memoverride.cpp" [$WIN32||$LINUX32]
		-$File	"$SRCDIR\public\tier0\memoverride.cpp" [$WIN64||$LINUX64]
	}
}
