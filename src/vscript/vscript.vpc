//-----------------------------------------------------------------------------
//	VSCRIPT.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$macro SRCDIR		".."

$conditional QUIRREL	1

$include "$SRCDIR\vpc_scripts\source_lib_base.vpc"

$include "vscript_squirrel.vpc" [!$QUIRREL]
$include "vscript_quirrel.vpc"	[$QUIRREL]

$Configuration
{
	$Compiler
	{
		$PreprocessorDefinitions		"$BASE;MAPBASE_VSCRIPT"		[$MAPBASE_VSCRIPT]
	}
}

$Project "VScript"
{
	$Folder	"Source Files"
	{
		$File	"vscript.cpp"
		$File	"vscript_bindings_base.cpp"
		$File	"vscript_bindings_base.h"
		$File	"vscript_bindings_math.cpp"
		$File	"vscript_bindings_math.h"
	}
}
