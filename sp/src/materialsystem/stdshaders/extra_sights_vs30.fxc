//-----------------------------------------------------------------------------
// Main shader entry point
//-----------------------------------------------------------------------------
VS_OUTPUT main( const VS_INPUT v )
{
	VS_OUTPUT o = ( VS_OUTPUT )0;

	//==========================================================================//
	//	Get the basic Vertex Shader Inputs
	//==========================================================================//

	// Tangents are also compressed onto the Normal
	// Brushes use TangentS and TangentT Vertex Inputs, Models don't.
	// TODO: Does this apply to all types of models?
	float3 vNormal;
	float4 vTangent_Binormal;
	DecompressVertex_Normal(v.vNormal, vNormal, vTangent_Binormal);

	// WorldPos is simply Input Pos
	float3 vPos = v.vPos.xyz;

	// We use this overloaded function to handle various cases of required outputs
	// TANGENTS == 0, WorldPos & WorldNormal
	// TANGENTS == 1, WorldPos & TBN Matrix
	// TANGENTS == 2, WorldPos & WorldNormal, Tangent + Binormal
	// 2 is required in case we ever run out of Interpolators
	// the 1.0f on the vPos f4 here is important for the distance component in the cModel/Blend Matrix
	float3 WorldNormal, WorldPos, Tangent, Binormal;
	AlignVertexInputs(SKINNING, float4(vPos, 1.0f), vNormal, vTangent_Binormal, v.vBoneWeights, v.vBoneIndices, WorldPos, WorldNormal, Tangent, Binormal);

	// IMPORTANT NOTE
	// Valve does this on the skin shader :
	// [0] = float3( TangentS.x, TangentT.x, Normal.x )
	// [1] = float3( TangentS.y, TangentT.y, Normal.y )
	// [2] = float3( TangentS.z, TangentT.z, Normal.z )
	// I have a bunch of theories why they did this
	// Its important because of the input order in mul()
	// If you do this to a matrix and don't adjust your mul()
	// It will mean you try to convert it into the opposite space than the one you actually want
	o.TBN_Matrix = float3x3(Tangent, Binormal, WorldNormal);

	// Transform into Projection Space ( Clip Space )
	// This will flatten the geometrical Position into a 2D-Plane
	float4 vProjPos = mul(float4(WorldPos, 1), cViewProj);
	o.ProjPosSetup = vProjPos;
	
	// Set WorldPos and compute Depth
	o.WorldPos_ProjPosZ.xyz = WorldPos;
	o.WorldPos_ProjPosZ.w = dot(float4(WorldPos, 1), cViewProjZ);

//==========================================================================//
// Calculations for UV's and their Transforms. This includes Seamless Mapping
//==========================================================================//

	// Previously : 
	// o.BaseDetailTexCoord.x = dot( v.vTexCoord0, cBaseTexCoordTransform[0] ) + cBaseTexCoordTransform[0].w;
	// o.BaseDetailTexCoord.y = dot( v.vTexCoord0, cBaseTexCoordTransform[1] ) + cBaseTexCoordTransform[1].w;
	// Also Previously, because I assumed it would be cheaper :
	// o.BaseDetailTexCoord.x = v.vTexCoord0.x * cBaseTexCoordTransform[0].x + cBaseTexCoordTransform[0].w;
	// o.BaseDetailTexCoord.y = v.vTexCoord0.y * cBaseTexCoordTransform[1].y + cBaseTexCoordTransform[1].w;
	// Now because I want to make sure that if anything ever lands on [].z it actually gets used...
	// DP4, ADD -> MAD with data loss? -> DP4
	// TODO: Run this through fxc.exe and see what happens. The goal here is least amount of instructions
	float4 UV = float4(v.vTexCoord0, 1.0f, 1.0f);

	o.TexCoords.x = dot(UV, cBaseTexCoordTransform[0]);
	o.TexCoords.y = dot(UV, cBaseTexCoordTransform[1]);

	#if DETAILUV
		o.TexCoords.z = dot(UV, cDetailTexCoordTransform[0]);
		o.TexCoords.w = dot(UV, cDetailTexCoordTransform[1]);
	#endif

    return o;
}